    "arabic",
    "darja",
    "algerian",
    "arabizi",
    "sentiment",
    "tokenizer",
    "stopwords",
    "code-switching"
  ],
  "author": "DZ Open Suite",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
