{
  "name": "@dz-open-suite/darja-nlp-kit",
  "version": "1.0.0",
  "description": "Zero-dependency NLP toolkit for Algerian Darja (Arabic/French/Arabizi code-switching)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "darja-nlp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npx tsx --test tests/index.test.ts",
    "clean": "rmdir /s /q dist 2>nul || true"
